# Copy to ios.local.env in the repo root (gitignored) and fill in. build_ios.sh reads it.
VR_IOS_TEAM_ID=
VR_IOS_BUNDLE_ID=
# Optional:
# VR_IOS_VERSION=0.4.0
# VR_IOS_BUILD=
# GODOT=/Applications/Godot.app/Contents/MacOS/Godot
# App Store Connect API key, for ./build_ios.sh upload without an Xcode login:
# VR_ASC_KEY_PATH=
# VR_ASC_KEY_ID=
# VR_ASC_ISSUER_ID=
