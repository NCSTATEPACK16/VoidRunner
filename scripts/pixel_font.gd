static var _font: FontFile


static func font() -> FontFile:
	if _font == null:
		_font = _build()
	return _font


## Make the pixel font every Control's default (HUD inside the game SubViewport
## included). The engine's default theme carries its own font, which wins over
## ThemeDB's fallback, so both get replaced — the default theme is the last stop
## of every Control's theme lookup, in every viewport.
static func install() -> void:
	ThemeDB.fallback_font = font()
	ThemeDB.fallback_font_size = SIZE
	var theme := ThemeDB.get_default_theme()
	theme.default_font = font()
	theme.default_font_size = SIZE


## The glyph bitmap as rows of booleans — also used by LogoGen to draw the
## chrome title logo from the same letterforms.
static func glyph_rows(ch: String) -> PackedStringArray:
	var src: String = GLYPHS.get(ch, GLYPHS["?"])
	return src.split("|")


static func _build() -> FontFile:
	var keys: Array = GLYPHS.keys()
	var cols := 16
	var rows := (keys.size() + cols - 1) / cols
	var atlas := Image.create(cols * ADVANCE, rows * ROWS, false, Image.FORMAT_LA8)
	var f := FontFile.new()
	f.fixed_size = SIZE
	f.fixed_size_scale_mode = TextServer.FIXED_SIZE_SCALE_INTEGER_ONLY
	f.antialiasing = TextServer.FONT_ANTIALIASING_NONE
	f.subpixel_positioning = TextServer.SUBPIXEL_POSITIONING_DISABLED
	f.hinting = TextServer.HINTING_NONE
	var fs := Vector2i(SIZE, 0)
	for i in keys.size():
		var ch: String = keys[i]
		var gx := (i % cols) * ADVANCE
		var gy := (i / cols) * ROWS
		var lines := glyph_rows(ch)
		for ry in lines.size():
			for rx in lines[ry].length():
				if lines[ry][rx] == "#":
					atlas.set_pixel(gx + rx, gy + ry, Color(1, 1, 1, 1))
		var code := ch.unicode_at(0)
		f.set_glyph_advance(0, SIZE, code, Vector2(ADVANCE, 0))
		f.set_glyph_offset(0, fs, code, Vector2(0, -ASCENT))
		f.set_glyph_size(0, fs, code, Vector2(ADVANCE, ROWS))
		f.set_glyph_uv_rect(0, fs, code, Rect2(gx, gy, ADVANCE, ROWS))
		f.set_glyph_texture_idx(0, fs, code, 0)
	f.set_texture_image(0, fs, 0, atlas)
	f.set_cache_ascent(0, SIZE, ASCENT)
	f.set_cache_descent(0, SIZE, DESCENT)
	return f
