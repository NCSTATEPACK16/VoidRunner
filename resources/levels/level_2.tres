script = ExtResource("1")
display_name = "L2 · SUPPLY ARTERY"
briefing = "The station's main supply artery feeds every deck. The swarm is using
it as a highway — and they have had time to dig in.

Expect heavier patrols. Watch the radar and keep moving; a still ship
is an easy target."
objective = "PUNCH THROUGH THE ARTERY"
